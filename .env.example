VITE_API_BASE_URL=https://backend-unipod.onrender.com/api

# Set to true to serve the frontend against MSW mock handlers (src/mocks)
# instead of the real backend — useful for role screens whose endpoints
# aren't deployed yet. Mock sign-in accounts: admin@unipod.test,
# factfinding@unipod.test, reviewer@unipod.test, coordinator@unipod.test,
# textile@unipod.test (any password).
VITE_ENABLE_MOCKS=false
